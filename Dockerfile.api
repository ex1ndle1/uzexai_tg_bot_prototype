# Ядро агента для Yandex Cloud VM.
# База DuckDB собирается из CSV на этапе build и остаётся в образе.
FROM python:3.14-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY agent ./agent
COPY uzex_spot_data ./uzex_spot_data

RUN python -m agent.etl

EXPOSE 8000

CMD ["uvicorn", "agent.api:app", "--host", "0.0.0.0", "--port", "8000"]
