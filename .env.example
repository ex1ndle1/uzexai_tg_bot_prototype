# ---------- Telegram ----------
BOT_TOKEN=

# ---------- LLM ----------
# Вариант A (рекомендуется): Ollama Cloud, gemma4:31b-cloud
# Ключ: https://ollama.com/settings/keys (нужен аккаунт и credit'ы)
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODELS=gemma4:31b-cloud

# Вариант B: OpenRouter, бесплатные модели
# Ключ: https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# LLM_MODELS=deepseek/deepseek-chat-v3.1:free,google/gemma-4-31b-it:free

# Необязательно: температура (0 — максимально предсказуемо)
# LLM_TEMPERATURE=0

# Необязательно: таймаут запроса к LLM в секундах (для локальных моделей увеличьте)
# LLM_TIMEOUT=90

# Необязательно: путь к базе DuckDB (по умолчанию data/uzex.duckdb)
# UZEX_DB=data/uzex.duckdb

# ---------- Связка Render (бот) <-> Yandex Cloud (ядро) ----------
# На ВМ: задайте AGENT_API_TOKEN, чтобы API требовал X-API-Key.
# На Render: AGENT_API_URL (адрес ядра) и тот же AGENT_API_TOKEN.
# Если AGENT_API_TOKEN пуст, API открыт — только для локальной разработки.
AGENT_API_TOKEN=
# AGENT_API_URL=http://<PUBLIC_IP>:8000
# AGENT_API_TIMEOUT=150
